# Optional. Only needed if you are NOT signed in with the `ant` CLI
# (`ant auth login`), which the Anthropic SDK picks up automatically.
# Copy to .env (git-ignored) and paste your key. Never commit .env.
ANTHROPIC_API_KEY=

# Only needed for `--provider openrouter` (open-weight models such as qwen/qwen3-14b).
OPENROUTER_API_KEY=
